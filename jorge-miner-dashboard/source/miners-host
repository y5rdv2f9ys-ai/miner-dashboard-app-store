#!/bin/sh
set -eu

use_sudo=0
if docker ps >/dev/null 2>&1; then
    :
elif command -v sudo >/dev/null 2>&1; then
    if sudo docker ps >/dev/null; then
        use_sudo=1
    else
        echo "Cannot access Docker with sudo." >&2
        exit 1
    fi
else
    echo "Cannot access Docker and sudo is unavailable." >&2
    exit 1
fi

docker_cli() {
    if [ "$use_sudo" -eq 1 ]; then
        sudo docker "$@"
    else
        docker "$@"
    fi
}

container_id="$(docker_cli ps \
    --filter label=com.docker.compose.project=jorge-miner-dashboard \
    --filter label=com.docker.compose.service=dashboard \
    --format '{{.ID}}' | sed -n '1p')"

if [ -z "$container_id" ]; then
    echo "Jorge Miner Dashboard container is not running." >&2
    exit 1
fi

if [ -t 0 ] && [ -t 1 ]; then
    exec_tty="-it"
else
    exec_tty="-i"
fi

if [ "$use_sudo" -eq 1 ]; then
    exec sudo docker exec "$exec_tty" "$container_id" miners-tui "$@"
fi
exec docker exec "$exec_tty" "$container_id" miners-tui "$@"
